# Copie ce fichier en ".env" puis modifie les valeurs si besoin.
#   Windows :  copy .env.example .env
#   Mac/Linux: cp .env.example .env

# --- Kafka (quand tu lances le producer depuis VS Code, pas depuis Docker) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Producer ---
# api = vraies APIs | replay = rejoue data/sample/crimes_synthetic.jsonl (démo)
PRODUCER_MODE=api
POLL_INTERVAL_SECONDS=300
MAX_RECORDS_PER_CITY=2000
REPLAY_SPEED=10
# Optionnel : token Socrata gratuit (Chicago/LA/NYC) pour avoir plus de quota
SOCRATA_APP_TOKEN=
# Optionnel : forcer le nombre de jours à récupérer au 1er lancement (toutes les villes)
# LOOKBACK_DAYS=30

# --- Spark / DBSCAN ---
DBSCAN_EPS_KM=0.5
DBSCAN_MIN_SAMPLES=5
# Un "hotspot" plus large que ce rayon est ignoré (effet de chaîne de DBSCAN)
HOTSPOT_MAX_RADIUS_KM=1.0

# --- Phase 3 : dbt + Snowflake ---
# dbt construit le schéma en étoile dans DuckDB (data/warehouse/crimewatch.duckdb) par défaut.
# Pour Snowflake : remplir les lignes ci-dessous puis DBT_TARGET=snowflake
# (essai gratuit : https://signup.snowflake.com). Ne JAMAIS mettre .env sur GitHub.
DBT_TARGET=duckdb
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CRIMEWATCH
